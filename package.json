{
  "name": "parametric-geometry-explorer",
  "version": "0.5.0",
  "type": "module",
  "homepage": "https://jaseknighter.github.io/parametric",
  "private": true,
  "display": "browser",
  "dependencies": {
    "file-saver": "^2.0.5",
    "immutability-helper": "^3.0.1",
    "mathjs": "^15.1.0",
    "react": "^16.9.0",
    "react-compound-slider": "^2.3.0",
    "react-dom": "^16.9.0",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^25.0.6",
    "@vitejs/plugin-react": "^5.1.2",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "gh-pages": "^6.3.0",
    "identity-obj-proxy": "^3.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^30.2.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.2.0",
    "monocart-reporter": "^2.9.23",
    "start-server-and-test": "^2.1.3",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^7.2.1",
    "wait-on": "^9.0.3"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:smoke": "playwright test smoke.spec.js",
    "test:smoke:watch": "playwright test smoke.spec.js --watch",
    "test:run-all-suites": "npm run test -- --coverage && VITE_COVERAGE=true npx playwright test && node scripts/merge-coverage.cjs",
    "test:run-all-suites:ci": "npm run test -- --coverage && VITE_COVERAGE=true npx playwright test tests/*.spec.js --update-snapshots && node scripts/merge-coverage.cjs",
    "test:full-baseline": "start-server-and-test 'npm run start' http://localhost:3000/parametric/ 'npm run test:run-all-suites'",
    "test:full-baseline:ci": "start-server-and-test 'npm run start' http://localhost:3000/parametric/ 'npm run test:run-all-suites:ci'"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/src/resources/OrbitControls.js",
      "<rootDir>/src/serviceWorker.js",
      "<rootDir>/src/containers/Parametric/workerHelper.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "src/services/**/*.{js,jsx}",
      "src/utilities/assertDiagnosticsBoundary.js",
      "!src/serviceWorker.js"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy",
      "^three/addons/(.*)$": "<rootDir>/node_modules/three/examples/jsm/$1",
      "^three/examples/jsm/controls/TrackballControls$": "<rootDir>/src/__mocks__/TrackballControls.js",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__mocks__/fileMock.js"
    },
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\](?!three).+\\.(js|jsx|mjs|cjs|ts|tsx)$",
      "node_modules/(?!(three|@playwright)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/backups/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/tests/"
    ]
  }
}
